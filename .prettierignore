# prettier reads .gitignore too, so the separate utopia-docs checkout is already
# excluded. dist and node_modules are repeated here so an explicit
# --ignore-path still skips them.
dist
node_modules

# generated by pnpm; rewriting it would fight the package manager.
pnpm-lock.yaml

# prose. prettier reformats fenced code blocks inside markdown, so running it
# over the docs would rewrite every example rather than tidy the prose.
*.md
